# Base URL of the API. "/api/v1" uses the Vite dev proxy (recommended in dev).
# In production set the full URL, e.g. https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Django backend the dev proxy forwards /api and /media to
VITE_PROXY_TARGET=http://localhost:8000

# Template profile: "store" | "video" | "books" (used from module M6)
VITE_SITE_PROFILE=store
